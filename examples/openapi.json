{
  "openapi": "3.1.0",
  "info": {
    "title": "Example API",
    "version": "1.0.0",
    "description": "A small example specification. Replace this file or update openapi.config.json to use your API."
  },
  "servers": [
    {
      "url": "https://{region}.example.com/{version}",
      "variables": {
        "region": { "default": "api" },
        "version": { "default": "v1" }
      }
    }
  ],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "schemas": {
      "ReportBase": {
        "type": "object",
        "required": ["id", "password", "artifact", "user-id"],
        "properties": {
          "id": { "type": "string" },
          "password": { "type": "string", "writeOnly": true },
          "artifact": { "type": "string", "format": "binary" },
          "user-id": { "type": "string" }
        }
      },
      "Report": {
        "$ref": "#/components/schemas/ReportBase",
        "required": ["user_id"],
        "properties": {
          "user_id": { "type": "string" }
        }
      },
      "WidgetDetail": {
        "type": "object",
        "required": ["id", "displayName"],
        "properties": {
          "id": { "type": "string" },
          "displayName": { "type": "string", "nullable": true },
          "metadata": {
            "anyOf": [{ "type": "object", "properties": { "source": { "type": "string" } } }, { "type": "null" }]
          },
          "opaque": { "anyOf": [{}, { "type": "null" }] },
          "exclusiveOpaque": { "oneOf": [{}, { "type": "string" }] }
        }
      },
      "UploadFailure": {
        "allOf": [
          {
            "type": "object",
            "required": ["failureId"],
            "properties": { "failureId": { "type": "string" } }
          },
          {
            "properties": { "error": { "type": "string" }, "retryAfter": { "type": "integer" } },
            "oneOf": [{ "required": ["error"] }, { "required": ["retryAfter"] }, { "enum": [null] }]
          }
        ]
      }
    },
    "parameters": {
      "WidgetId": {
        "in": "path",
        "name": "widgetId",
        "required": true,
        "description": "Widget ID",
        "schema": { "type": "string", "example": "widget_123" }
      },
      "TenantId": {
        "in": "header",
        "name": "X-Tenant-ID",
        "required": true,
        "schema": { "type": "string", "example": "tenant_123" }
      },
      "SessionId": {
        "in": "cookie",
        "name": "session_id",
        "required": true,
        "schema": { "type": "string", "example": "session_123" }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "requestBodies": {
      "EventBatch": {
        "required": true,
        "content": {
          "text/plain": {
            "schema": { "type": "string" }
          },
          "application/json": {
            "schema": {
              "type": "array",
              "description": "Event names",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "responses": {
      "AcceptedEvents": {
        "description": "Accepted events",
        "content": {
          "text/plain": {
            "schema": { "type": "string" }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["accepted", "warnings"],
              "properties": {
                "accepted": { "type": "integer" },
                "warnings": { "type": "array", "items": { "type": "string" }, "nullable": true }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/widgets": {
      "get": {
        "tags": ["Widgets"],
        "summary": "List widgets",
        "operationId": "list_widgets",
        "security": [{}, { "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": true,
            "description": "Maximum number of widgets to return",
            "schema": { "type": "integer", "default": 20 }
          }
        ],
        "responses": {
          "200": {
            "description": "Widgets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["widgets", "total"],
                  "properties": {
                    "widgets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "displayName"],
                        "properties": {
                          "id": { "type": "string", "description": "Widget ID" },
                          "displayName": { "type": "string", "description": "Widget display name" }
                        }
                      }
                    },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Widgets"],
        "summary": "Create widget",
        "operationId": "create_widget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": ["description", "id"],
                "properties": {
                  "description": { "type": "string", "nullable": true },
                  "id": { "type": "string", "readOnly": true },
                  "label": { "type": "string" }
                },
                "allOf": [
                  {
                    "required": ["region"],
                    "properties": {
                      "region": { "type": "string" }
                    },
                    "oneOf": [
                      {
                        "type": "object",
                        "required": ["provider", "settings"],
                        "properties": {
                          "provider": { "type": "string", "const": "cloud" },
                          "settings": { "type": "object", "additionalProperties": true }
                        }
                      },
                      {
                        "type": "object",
                        "required": ["provider", "settings"],
                        "properties": {
                          "provider": { "type": "string", "const": "local" },
                          "settings": { "type": "object", "additionalProperties": true }
                        }
                      }
                    ]
                  },
                  {
                    "type": "object",
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string", "description": "Widget name" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created widget",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["widgetId", "createdAt"],
                  "properties": {
                    "widgetId": { "type": "string" },
                    "createdAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/widgets/{widgetId}": {
      "parameters": [
        { "$ref": "#/components/parameters/WidgetId" },
        { "$ref": "#/components/parameters/TenantId" },
        { "$ref": "#/components/parameters/SessionId" }
      ],
      "get": {
        "tags": ["Widgets"],
        "summary": "Get widget",
        "operationId": "get_widget",
        "parameters": [
          {
            "in": "query",
            "name": "widgetId",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Widget",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WidgetDetail",
                  "nullable": true
                }
              }
            }
          }
        }
      }
    },
    "/uploads": {
      "post": {
        "tags": ["Uploads"],
        "summary": "Upload file",
        "operationId": "upload_file",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload result",
            "content": {
              "application/json": {
                "schema": {
                  "required": ["requestId"],
                  "properties": { "requestId": { "type": "string" } },
                  "anyOf": [
                    {
                      "type": "object",
                      "required": ["success"],
                      "properties": {
                        "success": { "type": "boolean", "const": true },
                        "widget": { "$ref": "#/components/schemas/WidgetDetail" },
                        "mixed": {
                          "anyOf": [
                            {
                              "type": "object",
                              "required": ["message"],
                              "properties": { "message": { "type": "string" } }
                            },
                            { "type": "string" }
                          ]
                        },
                        "constrained": {
                          "allOf": [
                            { "type": "object" },
                            {
                              "properties": {
                                "code": { "type": "string" },
                                "message": { "type": "string" }
                              },
                              "anyOf": [{ "required": ["code"] }, { "required": ["message"] }, { "type": "string" }]
                            }
                          ]
                        },
                        "primaryFailure": { "$ref": "#/components/schemas/UploadFailure" },
                        "secondaryFailure": { "$ref": "#/components/schemas/UploadFailure" }
                      }
                    },
                    { "$ref": "#/components/schemas/UploadFailure" }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/events/batch": {
      "post": {
        "tags": ["Events"],
        "summary": "Create events",
        "operationId": "create_events",
        "requestBody": { "$ref": "#/components/requestBodies/EventBatch" },
        "responses": {
          "200": { "$ref": "#/components/responses/AcceptedEvents" }
        }
      }
    },
    "/sessions": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Create session",
        "operationId": "create_session",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Session created" }
        }
      }
    },
    "/echo": {
      "post": {
        "tags": ["Echo"],
        "summary": "Echo text",
        "operationId": "echo_text",
        "security": [],
        "servers": [{ "url": "/v2" }],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": { "type": "string" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echoed text",
            "content": {
              "text/plain": {
                "schema": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/reports": {
      "get": {
        "tags": ["Reports"],
        "summary": "List reports",
        "operationId": "list_reports",
        "parameters": [
          {
            "in": "query",
            "name": "fields",
            "schema": { "type": "array", "items": { "type": "string" } },
            "style": "pipeDelimited",
            "explode": false
          }
        ],
        "responses": {
          "2XX": {
            "description": "Reports",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Report" }
                }
              }
            }
          }
        }
      }
    }
  }
}
